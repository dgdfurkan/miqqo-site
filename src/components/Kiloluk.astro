---
import { Picture } from 'astro:assets';
import { menu } from '../data/menu';
import { foodImage } from '../lib/images';
import { formatPrice } from '../data/site';

const category = menu.find((c) => c.id === 'kiloluk')!;
const labels = ['500 gr', '1 kg'];
---

<section class="kilo" id="kiloluk" aria-labelledby="kilo-baslik" data-kilo>
  <div class="container-site kilo__grid">
    <div class="kilo__intro">
      <h2 id="kilo-baslik" class="display kilo__title">Kalabalık sofralar için kiloluk</h2>
      <p class="kilo__lead">Eve ya da ofise, tartılıp paketlenir. Yanında yayık ayran hediye.</p>

      <fieldset class="switch">
        <legend class="sr-only">Porsiyon seç</legend>
        {
          labels.map((label, i) => (
            <label class="switch__option">
              <input type="radio" name="kiloluk-porsiyon" value={label} checked={i === 0} data-kilo-input />
              <span>{label}</span>
            </label>
          ))
        }
        <span class="switch__thumb" aria-hidden="true" data-kilo-thumb></span>
      </fieldset>
    </div>

    <ul class="kilo__list">
      {
        category.items.map((item) => (
          <li class="kilo__row">
            <div class="kilo__photo stage">
              <Picture
                class="cutout"
                src={foodImage(item.image!)}
                alt={item.name}
                widths={[160, 240, 330]}
                sizes="120px"
                formats={['webp']}
                loading="lazy"
              />
            </div>

            <div class="kilo__info">
              <h3 class="display kilo__name">{item.name}</h3>
              <p class="kilo__note" data-kilo-note>
                {item.variants!.map((v, i) => (
                  <span class="kilo__swap-item" data-index={i}>
                    {v.note}
                  </span>
                ))}
              </p>
            </div>

            <p class="display kilo__price" data-kilo-price>
              {item.variants!.map((v, i) => (
                <span class="kilo__swap-item" data-index={i}>
                  {formatPrice(v.price)}
                </span>
              ))}
            </p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import { gsap, prefersReducedMotion, allowMotionQuery } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('[data-kilo]');

  if (section) {
    const inputs = [...section.querySelectorAll<HTMLInputElement>('[data-kilo-input]')];
    const thumb = section.querySelector<HTMLElement>('[data-kilo-thumb]');
    let active = 0;

    const placeThumb = () => {
      const option = inputs[active].closest('label')!;
      if (!thumb) return;
      thumb.style.width = `${option.offsetWidth}px`;
      thumb.style.transform = `translateX(${option.offsetLeft}px)`;
    };

    const swap = (next: number) => {
      if (next === active) return;
      const direction = next > active ? 1 : -1;
      section.querySelectorAll<HTMLElement>('[data-kilo-price], [data-kilo-note]').forEach((holder) => {
        const outgoing = holder.querySelector<HTMLElement>(`[data-index="${active}"]`)!;
        const incoming = holder.querySelector<HTMLElement>(`[data-index="${next}"]`)!;
        incoming.classList.add('is-active');
        if (prefersReducedMotion()) {
          outgoing.classList.remove('is-active');
          gsap.set([outgoing, incoming], { clearProps: 'all' });
          return;
        }
        gsap.timeline({ defaults: { duration: 0.45, ease: 'expo.out' } })
          .fromTo(incoming, { yPercent: 110 * direction, autoAlpha: 0 }, { yPercent: 0, autoAlpha: 1 }, 0)
          .to(outgoing, { yPercent: -110 * direction, autoAlpha: 0, onComplete: () => outgoing.classList.remove('is-active') }, 0);
      });
      active = next;
      placeThumb();
    };

    inputs.forEach((input, index) => {
      input.addEventListener('change', () => input.checked && swap(index));
    });

    section.querySelectorAll<HTMLElement>('[data-index="0"]').forEach((el) => el.classList.add('is-active'));
    placeThumb();
    window.addEventListener('resize', placeThumb);

    // Satırlar görünüşe girince sırayla belirir
    gsap.matchMedia().add(allowMotionQuery, () => {
      gsap.fromTo(
        section.querySelectorAll('.kilo__row'),
        { autoAlpha: 0, y: 22 },
        {
          autoAlpha: 1,
          y: 0,
          duration: 0.8,
          stagger: 0.08,
          ease: 'expo.out',
          scrollTrigger: { trigger: section, start: 'top 76%' },
        }
      );
    });
  }
</script>

<style>
  .kilo {
    padding-block: clamp(56px, 8vw, 104px);
  }

  .kilo__grid {
    display: grid;
    gap: clamp(28px, 4vw, 64px);
  }

  .kilo__title {
    max-width: 16ch;
    font-size: clamp(2.5rem, 5.6vw, 4.75rem);
  }

  .kilo__lead {
    max-width: 32ch;
    margin-top: 1rem;
    color: rgb(241 232 216 / 0.8);
  }

  .switch {
    position: relative;
    display: inline-flex;
    gap: 0.25rem;
    margin-top: 1.75rem;
    padding: 0.3rem;
    border: 0;
    border-radius: 9999px;
    background-color: var(--color-is);
    box-shadow: inset 0 0 0 1px rgb(241 232 216 / 0.1);
  }

  .switch__option {
    position: relative;
    z-index: 1;
    cursor: pointer;
  }

  .switch__option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    cursor: pointer;
  }

  .switch__option span {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    padding-inline: 1.6rem;
    border-radius: 9999px;
    font-weight: 600;
    color: rgb(241 232 216 / 0.7);
    transition: color 0.3s ease;
  }

  .switch__option input:checked + span {
    color: var(--color-komur);
  }

  .switch__option input:focus-visible + span {
    outline: 2px solid var(--color-koz);
    outline-offset: 3px;
  }

  .switch__thumb {
    position: absolute;
    top: 0.3rem;
    left: 0;
    height: calc(100% - 0.6rem);
    border-radius: 9999px;
    background-color: var(--color-koz);
    transition: transform 0.45s var(--ease-expo), width 0.45s var(--ease-expo);
  }

  .kilo__list {
    display: grid;
  }

  .kilo__row {
    display: grid;
    grid-template-columns: 84px 1fr auto;
    align-items: center;
    gap: clamp(14px, 2vw, 28px);
    padding-block: clamp(16px, 2vw, 24px);
    box-shadow: inset 0 1px 0 rgb(241 232 216 / 0.12);
  }

  .kilo__row:last-child {
    box-shadow:
      inset 0 1px 0 rgb(241 232 216 / 0.12),
      inset 0 -1px 0 rgb(241 232 216 / 0.12);
  }

  .kilo__photo {
    aspect-ratio: 1;
  }

  .kilo__name {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
    line-height: 1;
  }

  .kilo__note,
  .kilo__price {
    position: relative;
    display: grid;
  }

  .kilo__swap-item {
    grid-area: 1 / 1;
    display: none;
  }

  .kilo__swap-item.is-active {
    display: block;
  }

  .kilo__note {
    overflow: hidden;
    margin-top: 0.3rem;
    color: var(--color-kul);
    font-size: 0.9rem;
  }

  .kilo__price {
    overflow: hidden;
    color: var(--color-koz);
    font-size: clamp(1.6rem, 2.6vw, 2.25rem);
    line-height: 1;
    text-align: right;
  }

  @media (min-width: 900px) {
    .kilo__grid {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      align-items: start;
    }

    .kilo__intro {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }

    .kilo__row {
      grid-template-columns: 112px 1fr auto;
    }
  }
</style>
