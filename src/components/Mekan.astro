---
import { Picture } from 'astro:assets';
import { venueImage } from '../lib/images';
import { mekanKareleri } from '../data/media';
---

<section class="mekan" id="mekan" aria-labelledby="mekan-baslik">
  <div class="container-site">
    <h2 id="mekan-baslik" class="display mekan__title">Mekan</h2>
    <p class="mekan__lead">
      Eryaman'da, Malazgirt 1071 Caddesi üzerinde. İçeride aile masaları ve çocuklar için oyun alanı var.
    </p>

    <div class="mekan__grid">
      {
        mekanKareleri.map((kare) => (
          <figure class:list={['kare', `kare--${kare.yer}`]} data-kare>
            <Picture
              src={venueImage(kare.slug)}
              alt={kare.alt}
              widths={[420, 700, 1100]}
              sizes="(min-width: 768px) 42vw, 92vw"
              formats={['avif', 'webp']}
              loading="lazy"
              data-media-id={`mekan-${kare.slug}`}
            />
            <figcaption class="kare__baslik">{kare.baslik}</figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { gsap, allowMotionQuery } from '../scripts/motion';

  const section = document.querySelector<HTMLElement>('.mekan');

  if (section) {
    gsap.matchMedia().add(allowMotionQuery, () => {
      gsap.fromTo(
        section.querySelectorAll('[data-kare]'),
        { autoAlpha: 0, y: 26, scale: 0.97 },
        {
          autoAlpha: 1,
          y: 0,
          scale: 1,
          duration: 0.9,
          stagger: 0.07,
          ease: 'expo.out',
          scrollTrigger: { trigger: section, start: 'top 80%' },
        }
      );
    });
  }
</script>

<style>
  .mekan {
    padding-block: clamp(56px, 9vw, 120px);
  }

  .mekan__title {
    font-size: clamp(2.75rem, 6.5vw, 6rem);
  }

  .mekan__lead {
    max-width: 40ch;
    margin-top: 1rem;
    color: rgb(241 232 216 / 0.8);
  }

  .mekan__grid {
    display: grid;
    gap: clamp(12px, 1.6vw, 20px);
    margin-top: clamp(28px, 4vw, 48px);
  }

  .kare {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-media);
    background-color: var(--color-is);
  }

  .motion .mekan__grid > .kare {
    visibility: hidden;
  }

  .kare :global(picture),
  .kare :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .kare :global(img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .kare__baslik {
    position: absolute;
    inset: auto 0 0;
    padding: clamp(12px, 1.8vw, 20px);
    background: linear-gradient(0deg, rgb(15 16 14 / 0.9), rgb(15 16 14 / 0.3) 70%, transparent);
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.5vw, 1.4rem);
    font-weight: 700;
  }

  @media (min-width: 768px) {
    .mekan__grid {
      grid-auto-flow: dense;
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .kare--buyuk {
      grid-column: span 7;
      grid-row: span 2;
    }

    .kare--buyuk :global(img) {
      aspect-ratio: 5 / 4;
    }

    .kare--dikey {
      grid-column: span 5;
    }

    .kare--dikey :global(img) {
      aspect-ratio: 16 / 10;
    }

    .kare--kucuk {
      grid-column: span 4;
    }

    .kare--genis {
      grid-column: span 8;
    }

    .kare--genis :global(img) {
      aspect-ratio: 16 / 9;
    }
  }
</style>
