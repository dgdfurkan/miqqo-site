---
import { Image, Picture } from 'astro:assets';
import Icon from './Icon.astro';
import wordmark from '../assets/brand/miqqo-wordmark.png';
import { klipler, klipPoster, klipSrc, panoGorselleri } from '../data/media';
import { findItem } from '../data/menu';
import { dishImage, hasDishImage, productImage, hasProductImage } from '../lib/images';
import { formatPrice, site } from '../data/site';
import { panoReklamlari } from '../data/kampanya';

// Günün panosu: Instagram hikâyesi gibi dikey kartlar, otomatik geçiş, fiyat yok.
// Kartların hepsi <template> içinde duruyor; günün tohumu seçiyor, seçilmeyenler
// klonlanırken siliniyor, yani medyaları hiç indirilmiyor.

const reklamMetni: Record<string, string> = {
  'ciger-sis': 'Günlük taze ciğer, közün üstünde.',
  'adana-kebap': 'Elde çekilmiş Adana, acısı yerinde.',
  'karisik-izgara': 'Hepsinden biraz, tek tepside.',
  'kuzu-pirzola': 'Kuzu pirzola, ocaktan sofraya.',
  'special-sis': 'Yarısı et, yarısı ciğer.',
  'kusbasili-pide': 'Odun ateşinde kuşbaşılı pide.',
  iskembe: 'Sabahın çorbası, kemik suyundan.',
  kunefe: 'Üstü fıstıklı, içi peynirli.',
  'kiremitte-kofte': 'Kiremitte köfte, kaşarı üstünde.',
  'yaprak-ciger': 'Yaprak ciğer, tereyağında.',
  'tavuk-kanat': 'Tavuk kanat, közde kızarmış.',
  'sac-kavurma': 'Saçta kavurma, köz biberli.',
};

const gorselKartlari = panoGorselleri
  .filter((slug) => hasProductImage(slug))
  .map((slug) => ({ slug, ad: findItem(slug)?.name ?? slug, metin: reklamMetni[slug] ?? 'Bugün sofrada.' }));
---

<dialog class="pano" aria-label="Günün panosu" data-pano>
  <div class="pano__panel" tabindex="-1" data-pano-panel>
    {/* Çubuklar burada, işaretlemede duruyor: JS ile üretilen eleman Astro'nun
        kapsamlı stilini almıyor ve yükseklik 0 kalıyor. */}
    <div class="pano__bars" aria-hidden="true" data-pano-bars>
      {[0, 1, 2, 3, 4].map(() => (
        <span class="pano__bar">
          <i />
        </span>
      ))}
    </div>

    <header class="pano__head">
      <Image src={wordmark} alt="Ciğerci Miqqo" width={96} densities={[1, 2]} class="pano__logo" />
      <span class="pano__gun" data-pano-gun></span>
      <button class="pano__close" type="button" aria-label="Panoyu kapat" data-pano-close>
        <Icon name="x-bold" size={18} />
      </button>
    </header>

    <div class="pano__stage" data-pano-stage></div>

    <button class="pano__zone pano__zone--geri" type="button" aria-label="Önceki" data-pano-geri></button>
    <button class="pano__zone pano__zone--ileri" type="button" aria-label="Sonraki" data-pano-ileri></button>

    <footer class="pano__foot">
      <a class="btn btn-koz" href="/menu">Menüyü gör</a>
      <a class="btn btn-line" href={site.phone.href} aria-label={`Telefonla ara: ${site.phone.display}`}>
        <Icon name="phone-bold" size={18} />
        <span>{site.phone.display}</span>
      </a>
    </footer>
  </div>
</dialog>

<template data-pano-tpl>
  {
    klipler.map((k) => (
      <article class="kart kart--video" data-pano-card data-tip="video">
        <video
          class="kart__medya"
          data-media-id={k.id}
          data-src={klipSrc(k)}
          poster={klipPoster(k)}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"></video>
        <div class="kart__yazi">
          <p class="display kart__baslik">{k.baslik}</p>
          <p class="kart__metin">{k.metin}</p>
        </div>
      </article>
    ))
  }
  {
    gorselKartlari.map((kart) => (
      <article class="kart" data-pano-card data-tip="gorsel" data-slug={kart.slug}>
        <Picture
          class="kart__medya"
          src={productImage(kart.slug)}
          alt={kart.ad}
          widths={[420, 640, 900]}
          sizes="(min-width: 640px) 420px, 92vw"
          formats={['webp']}
          loading="lazy"
          data-media-id={`urun-${kart.slug}`}
        />
        <div class="kart__yazi">
          <p class="display kart__baslik">{kart.ad}</p>
          <p class="kart__metin">{kart.metin}</p>
        </div>
      </article>
    ))
  }
  {
    panoReklamlari
      .filter((reklam) => hasDishImage(reklam.gorsel))
      .map((reklam) => (
        <article class="kart kart--reklam" data-pano-card data-tip="reklam" data-slug={reklam.gorsel}>
          <Picture
            class="kart__medya kart__medya--sonuk"
            src={dishImage(reklam.gorsel)}
            alt={reklam.baslik}
            widths={[420, 640]}
            sizes="(min-width: 640px) 420px, 92vw"
            formats={['webp']}
            loading="lazy"
            data-media-id={`urun-${reklam.gorsel}`}
          />
          <div class="kart__reklam">
            <p class="kart__ust">{reklam.ustyazi}</p>
            <p class="display kart__fiyat">{formatPrice(reklam.fiyat)}</p>
            <p class="kart__fiyat-not">{reklam.fiyatNotu}</p>
            <p class="display kart__baslik kart__baslik--reklam">{reklam.baslik}</p>
            <p class="kart__metin">{reklam.metin}</p>
          </div>
        </article>
      ))
  }
</template>

<script>
  import { gsap, lockScroll, prefersReducedMotion } from '../scripts/motion';

  const KEY = 'miqqo-duyuru';
  const GORSEL_SURE = 3.8;
  const VIDEO_SURE = 5.4;
  // Reklam karesinde fiyat ve iki satır yazı var, okumak için biraz daha uzun durur.
  const REKLAM_SURE = 4.8;

  const dialog = document.querySelector<HTMLDialogElement>('[data-pano]');
  const template = document.querySelector<HTMLTemplateElement>('[data-pano-tpl]');
  const stage = dialog?.querySelector<HTMLElement>('[data-pano-stage]');
  const bars = dialog?.querySelector<HTMLElement>('[data-pano-bars]');
  const panel = dialog?.querySelector<HTMLElement>('[data-pano-panel]');
  const gunEl = dialog?.querySelector<HTMLElement>('[data-pano-gun]');

  if (dialog && template && stage && bars && panel) {
    const gunKodu = () =>
      new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Europe/Istanbul',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit',
      }).format(new Date());

    const gunYazisi = () =>
      new Intl.DateTimeFormat('tr-TR', { timeZone: 'Europe/Istanbul', day: 'numeric', month: 'long' }).format(
        new Date()
      );

    const tohum = (metin: string) => {
      let h = 2166136261;
      for (let i = 0; i < metin.length; i += 1) {
        h ^= metin.charCodeAt(i);
        h = Math.imul(h, 16777619);
      }
      return h >>> 0;
    };

    const zar = (seed: number) => () => {
      seed = (seed + 0x6d2b79f5) | 0;
      let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
      t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
      return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
    };

    let kartlar: HTMLElement[] = [];
    let sira = 0;
    let sayac: gsap.core.Tween | null = null;

    const karistir = <T,>(dizi: T[], rand: () => number) =>
      dizi
        .map((oge) => ({ oge, n: rand() }))
        .sort((a, b) => a.n - b.n)
        .map((x) => x.oge);

    // Günün kartları: video ile başlar, video ve fotoğraf sırayla gelir.
    const kur = (gun: string) => {
      const rand = zar(tohum(gun));
      const parca = template.content.cloneNode(true) as DocumentFragment;
      const videolar = karistir([...parca.querySelectorAll<HTMLElement>('[data-tip="video"]')], rand);
      const gorseller = karistir([...parca.querySelectorAll<HTMLElement>('[data-tip="gorsel"]')], rand);
      const reklamlar = karistir([...parca.querySelectorAll<HTMLElement>('[data-tip="reklam"]')], rand);
      // Sıra: video, tabak, reklam, video, tabak. Reklam ortada duruyor, günün
      // reklamı tohumla değişiyor. Hikâye akışı bozulmuyor, araya bir ilan giriyor.
      const reklam = reklamlar[0];
      // Reklamdaki ürün ayrıca tabak karesi olarak çıkmasın: ölçümde işkembe hem
      // reklamda hem üçüncü karede görünüyordu.
      const tabaklar = gorseller.filter((kart) => kart.dataset.slug !== reklam?.dataset.slug);
      const secilen = [videolar[0], tabaklar[0], reklam, videolar[1], tabaklar[1]].filter(Boolean);

      [...videolar, ...gorseller, ...reklamlar].forEach((kart) => {
        if (!secilen.includes(kart)) kart.remove();
      });
      secilen.forEach((kart) => stage.appendChild(kart));

      kartlar = secilen;
      [...bars.children].forEach((bar, i) => {
        (bar as HTMLElement).hidden = i >= kartlar.length;
        const dolu = bar.firstElementChild as HTMLElement | null;
        if (dolu) gsap.set(dolu, { scaleX: 0 });
      });
      if (gunEl) gunEl.textContent = gunYazisi();
      // İlk iki kartın videosu hemen yüklenmeye başlar, açılışta ilk kare beklemesin.
      videoyuHazirla(kartlar[0]);
      videoyuHazirla(kartlar[1]);
    };

    const videoyuHazirla = (kart?: HTMLElement) => {
      const video = kart?.querySelector<HTMLVideoElement>('video');
      if (!video || video.src || !video.dataset.src) return;
      video.src = video.dataset.src;
    };

    const durdur = () => {
      sayac?.kill();
      sayac = null;
      kartlar.forEach((kart) => {
        kart.querySelector('video')?.pause();
        const medya = kart.querySelector<HTMLElement>('.kart__medya');
        const yazi = kart.querySelector<HTMLElement>('.kart__yazi');
        if (medya) gsap.killTweensOf(medya);
        if (yazi) gsap.killTweensOf(yazi);
      });
    };

    const goster = (index: number) => {
      if (!kartlar.length) return;
      if (index >= kartlar.length) return kapat();
      sira = Math.max(0, index);
      durdur();

      kartlar.forEach((kart, i) => kart.classList.toggle('is-active', i === sira));
      [...bars.children].forEach((bar, i) => {
        const dolu = bar.firstElementChild as HTMLElement;
        gsap.killTweensOf(dolu);
        gsap.set(dolu, { scaleX: i < sira ? 1 : 0 });
      });

      const kart = kartlar[sira];
      const video = kart.querySelector<HTMLVideoElement>('video');
      videoyuHazirla(kart);
      videoyuHazirla(kartlar[sira + 1]);
      if (video) void video.play().catch(() => {});

      const tip = kart.dataset.tip;
      const sure = tip === 'video' ? VIDEO_SURE : tip === 'reklam' ? REKLAM_SURE : GORSEL_SURE;

      if (!prefersReducedMotion()) {
        // Kare yavaşça yaklaşır, yazı alttan gelir: hikâye hissi buradan geliyor.
        const medya = kart.querySelector<HTMLElement>('.kart__medya');
        const yazi = kart.querySelector<HTMLElement>('.kart__yazi, .kart__reklam');
        if (medya) gsap.fromTo(medya, { scale: 1.08 }, { scale: 1, duration: sure + 0.8, ease: 'none' });
        if (yazi)
          gsap.fromTo(yazi, { autoAlpha: 0, y: 16 }, { autoAlpha: 1, y: 0, duration: 0.5, ease: 'expo.out', delay: 0.12 });
      }

      const dolu = bars.children[sira]?.firstElementChild as HTMLElement | undefined;
      if (!dolu) return;

      if (prefersReducedMotion()) {
        gsap.set(dolu, { scaleX: 1 });
        return;
      }
      sayac = gsap.fromTo(
        dolu,
        { scaleX: 0 },
        { scaleX: 1, duration: sure, ease: 'none', onComplete: () => goster(sira + 1) }
      );
    };

    const kapat = () => {
      durdur();
      const bitir = () => {
        dialog.close();
        lockScroll(false);
        stage.replaceChildren();
        [...bars.children].forEach((bar) => {
          const dolu = bar.firstElementChild as HTMLElement | null;
          if (dolu) gsap.set(dolu, { scaleX: 0 });
        });
        gsap.set(panel, { clearProps: 'all' });
      };
      if (prefersReducedMotion()) return bitir();
      gsap.to(panel, { autoAlpha: 0, scale: 0.98, duration: 0.28, ease: 'power2.in', onComplete: bitir });
    };

    const ac = (zorla = false) => {
      const gun = gunKodu();
      if (!zorla) {
        try {
          if (localStorage.getItem(KEY) === gun) return;
        } catch {}
      }
      kur(gun);
      dialog.showModal();
      // Odak panele alınır; yoksa tarayıcı kapatma düğmesine odaklanıp ilk karede
      // turuncu odak halkası gösteriyor.
      panel.focus({ preventScroll: true });
      lockScroll(true);
      try {
        localStorage.setItem(KEY, gun);
      } catch {}

      if (prefersReducedMotion()) {
        goster(0);
        return;
      }
      const head = dialog.querySelector<HTMLElement>('.pano__head');
      const foot = dialog.querySelector<HTMLElement>('.pano__foot');
      gsap
        .timeline()
        .fromTo(panel, { autoAlpha: 0, y: 26, scale: 0.94 }, { autoAlpha: 1, y: 0, scale: 1, duration: 0.55, ease: 'expo.out' })
        .fromTo(
          [bars, head].filter(Boolean),
          { autoAlpha: 0, y: -10 },
          { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out', stagger: 0.06 },
          0.12
        )
        .fromTo([foot].filter(Boolean), { autoAlpha: 0, y: 14 }, { autoAlpha: 1, y: 0, duration: 0.4, ease: 'power2.out' }, 0.18)
        .add(() => goster(0), 0.14);
    };

    dialog.querySelector('[data-pano-close]')?.addEventListener('click', kapat);
    dialog.querySelector('[data-pano-ileri]')?.addEventListener('click', () => goster(sira + 1));
    dialog.querySelector('[data-pano-geri]')?.addEventListener('click', () => goster(Math.max(sira - 1, 0)));
    dialog.addEventListener('cancel', (event) => {
      event.preventDefault();
      kapat();
    });
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) kapat();
    });
    dialog.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', kapat));
    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') goster(sira + 1);
      if (event.key === 'ArrowLeft') goster(Math.max(sira - 1, 0));
    });

    // Dokunmatikte kaydırarak geçiş
    let basla = 0;
    panel.addEventListener('touchstart', (e) => (basla = e.changedTouches[0].clientX), { passive: true });
    panel.addEventListener(
      'touchend',
      (e) => {
        const fark = e.changedTouches[0].clientX - basla;
        if (Math.abs(fark) < 45) return;
        goster(fark < 0 ? sira + 1 : Math.max(sira - 1, 0));
      },
      { passive: true }
    );

    document.addEventListener('visibilitychange', () => {
      if (!dialog.open) return;
      if (document.hidden) durdur();
      else goster(sira);
    });

    document.querySelectorAll('[data-duyuru-open]').forEach((el) =>
      el.addEventListener('click', (event) => {
        event.preventDefault();
        ac(true);
      })
    );

    window.setTimeout(() => ac(false), 550);
  }
</script>

<style>
  .pano {
    width: 100%;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: none;
    color: var(--color-lavas);
  }

  .pano[open] {
    position: fixed;
    inset: 0;
    display: grid;
    place-items: center;
    height: 100dvh;
    padding: clamp(10px, 2vw, 28px);
  }

  /* Perde: arka sayfa hafifçe bulanıklaşıp koyulaşır, panel önde kalır */
  .pano::backdrop {
    background-color: rgb(6 7 6 / 0.84);
    backdrop-filter: blur(4px);
    animation: pano-perde 0.38s var(--ease-soft) both;
  }

  @keyframes pano-perde {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pano::backdrop {
      animation: none;
      backdrop-filter: none;
    }
  }

  /* Hikâye paneli: dikey, telefon oranında */
  .pano__panel {
    position: relative;
    display: grid;
    grid-template-rows: auto auto 1fr auto;
    width: min(94vw, 26rem);
    height: min(88dvh, 46rem);
    overflow: hidden;
    border-radius: var(--radius-sheet);
    background-color: #0b0c0a;
    box-shadow:
      inset 0 0 0 1px rgb(241 232 216 / 0.14),
      0 30px 90px rgb(0 0 0 / 0.6);
  }

  .pano__panel:focus-visible {
    outline: none;
  }

  .pano__bars {
    z-index: 3;
    display: flex;
    gap: 5px;
    padding: 0.8rem 0.9rem 0.1rem;
  }

  .pano__bar {
    position: relative;
    flex: 1;
    height: 4px;
    overflow: hidden;
    border-radius: 999px;
    background-color: rgb(241 232 216 / 0.32);
  }

  .pano__bar i {
    position: absolute;
    inset: 0;
    display: block;
    background-color: var(--color-lavas);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .pano__head {
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.8rem 0.2rem;
  }

  .pano__head :global(.pano__logo) {
    width: 96px;
    height: auto;
  }

  .pano__gun {
    color: rgb(241 232 216 / 0.65);
    font-size: 0.75rem;
  }

  .pano__close {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    margin-left: auto;
    border-radius: 9999px;
    background-color: rgb(241 232 216 / 0.12);
    color: var(--color-lavas);
  }

  .pano__stage {
    position: relative;
    grid-row: 3;
    overflow: hidden;
  }

  .kart {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.45s var(--ease-soft);
  }

  .kart.is-active {
    opacity: 1;
    visibility: visible;
  }

  .kart :global(picture),
  .kart :global(.kart__medya) {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Oran korunur, kutuya sığmayan kısım kırpılır */
  .kart :global(img),
  .kart video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .kart__yazi {
    position: absolute;
    inset: auto 0 0;
    display: grid;
    gap: 0.2rem;
    padding: clamp(16px, 4vw, 24px);
    background: linear-gradient(0deg, rgb(11 12 10 / 0.95), rgb(11 12 10 / 0.45) 55%, transparent);
  }

  .kart__baslik {
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    line-height: 1;
  }

  .kart__metin {
    color: rgb(241 232 216 / 0.82);
    font-size: 0.95rem;
  }

  /* Reklam karesi: fotoğraf sönük arkada durur, fiyat ortada. Hikâye karesinden
     ayrışsın diye yazı ortaya hizalı ve zemin daha koyu. */
  .kart--reklam {
    background-color: #0b0c0a;
  }

  .kart :global(.kart__medya--sonuk) {
    opacity: 0.34;
  }

  .kart__reklam {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: center;
    gap: 0.25rem;
    padding: clamp(20px, 6vw, 34px);
  }

  .kart__ust {
    color: var(--color-koz);
    font-family: var(--font-display);
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .kart__fiyat {
    font-size: clamp(3.4rem, 15vw, 4.8rem);
    line-height: 0.85;
  }

  .kart__fiyat-not {
    color: rgb(241 232 216 / 0.7);
    font-size: 0.9rem;
  }

  .kart__baslik--reklam {
    margin-top: 0.8rem;
  }

  /* Kartın sağına ve soluna tıklayınca hikâye ilerler */
  .pano__zone {
    position: absolute;
    top: 4.2rem;
    bottom: 5.5rem;
    z-index: 2;
    width: 32%;
    background: none;
    cursor: pointer;
  }

  .pano__zone--geri {
    left: 0;
  }

  .pano__zone--ileri {
    right: 0;
    width: 46%;
  }

  .pano__foot {
    position: relative;
    z-index: 3;
    display: flex;
    gap: 0.5rem;
    padding: 0.8rem;
    background: linear-gradient(0deg, #0b0c0a, rgb(11 12 10 / 0.8));
  }

  .pano__foot .btn {
    flex: 1;
    min-height: 2.9rem;
    padding-inline: 0.9rem;
    font-size: 0.9rem;
  }
</style>
